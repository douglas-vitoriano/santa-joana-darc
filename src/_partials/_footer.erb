<% footer = site.metadata.footer %>
<footer class="footer-medieval">
  <div class="container">
    <div class="columns">
      <div class="column is-4">
        <p class="title is-5">
          <strong><%= site.metadata.title %></strong><br/>
          <i class="is-size-7"><%= footer["title_sub"] %></i>
        </p>
        <p><%= footer["description"] %></p>
      </div>
      <div class="column is-4">
        <p class="title is-6"><%= footer["meetings_title"] %></p>
        <p><%= footer["meetings_topics"] %></p>
      </div>
      <div class="column is-4">
        <p class="title is-6"><%= footer["quote_title"] %></p>
        <p>
          <em>"<%= footer["quote_text"] %>"</em><br />
          <%= footer["quote_author"] %>
        </p>
      </div>
    </div>
    <hr class="footer-divider" />
    <p class="footer-credits"><%= footer["credits"] %></p>
  </div>
</footer>
