---
layout: default
title: Início
---
<% home = site.metadata.pages["home"] %>

<section class="hero hero-santa is-medium">
  <div class="hero-body">
    <div class="container">
      <div class="columns is-vcentered">
        <div class="column is-6 fade-in-up">
          <p class="hero-eyebrow"><%= home["hero_eyebrow"] %></p>
          <h1 class="title is-1 hero-title">
            <%= home["hero_title_line1"] %><br/>
            <%= home["hero_title_line2"] %>
          </h1>
          <hr class="hero-divider" />
          <p class="hero-subtitle">
            <%= home["hero_subtitle_line1"] %><br/>
            <%= home["hero_subtitle_line2"] %>
          </p>
          <div class="buttons mt-5">
            <a href="/joana-darc/" class="button is-gold"><%= home["btn_joana"] %></a>
            <a href="/estante/" class="button is-outline-gold"><%= home["btn_estante"] %></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-cream">
  <div class="container">
    <h2 class="section-title"><%= home["section_sobre_title"] %></h2>
    <p class="section-subtitle"><%= home["section_sobre_sub"] %></p>
    <div class="ornament">
      <span class="ornament-line"></span>
      <span class="ornament-cross">✦</span>
      <span class="ornament-line right"></span>
    </div>
    <div class="columns is-multiline">
      <% (home["cards"] || []).each_with_index do |card, i| %>
        <div class="column is-4 fade-in-up delay-<%= i + 1 %>">
          <div class="card-medieval">
            <div class="card-header">
              <p class="card-header-title"><%= card["title"] %></p>
            </div>
            <div class="card-content">
              <p><%= card["text"] %></p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<section class="section section-smoke">
  <div class="container">
    <div class="columns is-vcentered">
      <div class="column is-4 has-text-centered is-hidden-mobile">
        <picture>
          <source srcset="/images/santa_joana_darc_white.png" media="(prefers-color-scheme: dark)" />
          <img src="/images/santa_joana_darc_transparente.png"
               alt="<%= home["quote_img_alt"] %>"
               class="quote-portrait"
               width="320" height="406"
               loading="lazy" />
        </picture>
      </div>
      <div class="column is-8">
        <% (home["quotes"] || []).each do |q| %>
          <div class="quote-medieval mt-4">
            <%= q["text"] %>
            <span class="quote-author"><%= q["author"] %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="section section-cream">
  <div class="container">
    <h2 class="section-title"><%= home["section_temas_title"] %></h2>
    <p class="section-subtitle"><%= home["section_temas_sub"] %></p>
    <div class="ornament">
      <span class="ornament-line"></span>
      <span class="ornament-cross">✦</span>
      <span class="ornament-line right"></span>
    </div>
    <div class="columns is-multiline">
      <% site.data.temas.each do |tema| %>
        <div class="column is-6">
          <div class="book-card">
            <p class="book-title"><%= tema["titulo"] %></p>
            <p class="book-description"><%= tema["descricao"] %></p>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
