<% metadata = site.metadata %>
<% nav = metadata.navbar %>
<% pwa = metadata.pwa %>

<!doctype html>
<html lang="pt-BR">
  <head>
    <%= render "head", metadata: metadata, title: data.title %>
  </head>
  <body class="<%= data.layout %> <%= data.page_class %>">

    <div id="pwa-update-banner" class="notification is-warning is-hidden" style="position:fixed;top:0;left:0;right:0;z-index:9999;border-radius:0;margin:0;">
      <button class="delete"></button>
      <span class="pwa-update-text"><%= pwa["update_text"] %></span>
      <button class="pwa-btn pwa-btn--confirm" onclick="window.updateSW()">
        <%= pwa["update_btn"] %>
      </button>
    </div>

    <div id="pwa-install-banner" class="notification is-hidden" style="position:fixed;bottom:0;left:0;right:0;z-index:9999;border-radius:0;margin:0;">
      <button class="delete"></button>
      <picture class="pwa-install-icon-wrap">
        <source srcset="/images/icons/icon_white-72x72.png" media="(prefers-color-scheme: dark)" />
        <img src="/images/icons/icon_black-72x72.png"
            alt="<%= metadata.title %>"
            class="pwa-install-icon"
            width="48" height="48" />
      </picture>
      <div class="pwa-install-text">
        <p class="pwa-install-title"><%= "Instalar #{metadata.title}" %></p>
        <p class="pwa-install-sub"><%= pwa["install_sub"] %></p>
      </div>
      <div class="pwa-install-actions">
        <button id="pwa-install-btn" class="pwa-btn pwa-btn--install">
          <%= pwa["install_btn"] %>
        </button>
      </div>
    </div>

    <div id="ios-install-hint" class="notification is-hidden" style="position:fixed;bottom:0;left:0;right:0;z-index:9999;border-radius:0;margin:0;">
      <button class="delete"></button>
      <span><%= pwa["ios_hint"] %></span>
    </div>

    <div id="pwa-installed-badge" class="notification is-success is-hidden" style="position:fixed;bottom:1rem;right:1rem;z-index:9999;width:auto;">
      <span><%= pwa["installed_badge"] %></span>
    </div>

    <%= render Shared::Navbar.new(metadata: metadata, resource: resource) %>

    <main>
      <%= yield %>
    </main>

    <%= render "footer", metadata: metadata %>
  </body>
</html>
