<% metadata = site.metadata %>
<% nav = metadata.navbar %>
<% pwa = metadata.pwa %>

<!doctype html>
<html lang="pt-BR">
  <head>
    <%= render "head", metadata: metadata, title: data.title %>
  </head>
  <body class="<%= data.layout %> <%= data.page_class %>">

    <%# Banner: atualização disponível %>
    <div id="pwa-update-banner"
         class="pwa-update-banner is-hidden"
         role="alert"
         aria-live="polite"
         aria-label="Atualização disponível">
      <span class="pwa-update-text"><%= pwa["update_text"] %></span>
      <div class="pwa-update-actions">
        <button class="pwa-btn pwa-btn--confirm" onclick="window.updateSW()">
          <%= pwa["update_btn"] %>
        </button>
        <button class="delete is-small"
                aria-label="<%= pwa["close_label"] %>">
        </button>
      </div>
    </div>

    <%# Banner: instalar app (Android/Chrome) %>
    <div id="pwa-install-banner"
         class="pwa-install-banner is-hidden"
         role="complementary"
         aria-label="Instalar aplicativo">
      <picture class="pwa-install-icon-wrap">
        <source srcset="/images/icons/icon_white-72x72.png" media="(prefers-color-scheme: dark)" />
        <img src="/images/icons/icon_black-72x72.png"
             alt=""
             class="pwa-install-icon"
             width="40" height="40"
             aria-hidden="true" />
      </picture>
      <div class="pwa-install-text">
        <p class="pwa-install-title"><%= "Instalar #{metadata.title}" %></p>
        <p class="pwa-install-sub"><%= pwa["install_sub"] %></p>
      </div>
      <div class="pwa-install-actions">
        <button id="pwa-install-btn" class="pwa-btn pwa-btn--install">
          <%= pwa["install_btn"] %>
        </button>
        <button class="delete is-small"
                aria-label="<%= pwa["close_label"] %>">
        </button>
      </div>
    </div>

    <%# Hint iOS %>
    <div id="ios-install-hint"
         class="ios-install-hint is-hidden"
         role="status"
         aria-live="polite">
      <span><%= pwa["ios_hint"] %></span>
      <button class="delete is-small"
              aria-label="<%= pwa["close_label"] %>">
      </button>
    </div>

    <%# Badge: app instalado (some sozinho) %>
    <div id="pwa-installed-badge"
         class="pwa-installed-badge is-hidden"
         role="status"
         aria-live="polite">
      <span>✓ <%= pwa["installed_badge"] %></span>
    </div>

    <%= render Shared::Navbar.new(metadata: metadata, resource: resource) %>

    <main>
      <%= yield %>
    </main>

    <%= render "footer", metadata: metadata %>
  </body>
</html>
